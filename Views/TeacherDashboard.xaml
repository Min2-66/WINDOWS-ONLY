<Window x:Class="ScholasticaReader.Views.TeacherDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teacher Dashboard" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F5F5F5">
        <StackPanel Margin="20">
            <TextBlock Text="Class Progress" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
            <DataGrid x:Name="ProgressGrid" AutoGenerateColumns="True" Margin="0,10,0,10" Height="250" BorderBrush="#DDD" BorderThickness="1"/>
            <Button Content="Assign Reading" Click="AssignReading_Click" Margin="0,10" Padding="10,5" Width="150"/>
        </StackPanel>
    </Grid>
</Window>
