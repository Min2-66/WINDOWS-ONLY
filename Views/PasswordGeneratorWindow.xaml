<Window x:Class="ScholasticaReader.Views.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Generator" Height="550" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        MinHeight="500" MinWidth="600">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Top">
                <!-- Title -->
                <TextBlock Text="Secure Password Generator" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>
                
                <!-- Password Display -->
                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="0,0,0,15" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GeneratedPasswordBox" Grid.Column="0" 
                                 Text="Click Generate" IsReadOnly="True" FontSize="14" 
                                 Padding="10" BorderThickness="0" Foreground="#333" FontFamily="Consolas"/>
                        <Button Content="Copy" Click="CopyPassword_Click" Grid.Column="1" 
                                Margin="5,0,0,0" Background="#4CAF50" Foreground="White" FontWeight="Bold" Padding="5"/>
                    </Grid>
                </Border>

                <!-- Password Strength Indicator -->
                <TextBlock x:Name="StrengthIndicator" Text="Strength: ---" Foreground="Gray" Margin="0,0,0,15" FontWeight="Bold"/>

                <!-- Length Slider -->
                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="15" CornerRadius="5" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Password Length:" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Slider x:Name="LengthSlider" Minimum="8" Maximum="32" Value="16" 
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,5,0,10"/>
                        <TextBlock x:Name="LengthDisplay" Text="Length: 16" Foreground="#666"/>
                    </StackPanel>
                </Border>

                <!-- Character Type Checkboxes -->
                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="15" CornerRadius="5" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Character Types:" FontWeight="Bold" Margin="0,0,0,10"/>
                        <CheckBox x:Name="IncludeUppercaseCheckBox" Content="Uppercase (A-Z)" IsChecked="True" Margin="0,5" Padding="5"/>
                        <CheckBox x:Name="IncludeLowercaseCheckBox" Content="Lowercase (a-z)" IsChecked="True" Margin="0,5" Padding="5"/>
                        <CheckBox x:Name="IncludeNumbersCheckBox" Content="Numbers (0-9)" IsChecked="True" Margin="0,5" Padding="5"/>
                        <CheckBox x:Name="IncludeSpecialCheckBox" Content="Special (!@#$%)" IsChecked="True" Margin="0,5" Padding="5"/>
                    </StackPanel>
                </Border>

                <!-- Excluded Characters -->
                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="15" CornerRadius="5" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Exclude Characters (Optional):" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBox x:Name="ExcludeCharsBox" Padding="10" Height="35" 
                                 Text="" Foreground="#666" BorderBrush="#CCC" BorderThickness="1"/>
                        <TextBlock Text="Example: i,l,1,O,0 (to avoid confusing characters)" FontSize="10" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,10">
                    <Button Content="Generate Password" Click="GeneratePassword_Click" 
                            Background="#2196F3" Foreground="White" Padding="15,10" 
                            Margin="0,0,10,0" FontWeight="Bold" Width="160"/>
                    <Button Content="Clear All" Click="ClearAll_Click" 
                            Background="#757575" Foreground="White" Padding="15,10" 
                            FontWeight="Bold" Width="110"/>
                </StackPanel>
                
                <!-- Info Text -->
                <TextBlock Text="💡 Passwords are generated using cryptographic randomization for maximum security." 
                           FontSize="10" Foreground="#999" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
