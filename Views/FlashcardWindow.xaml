<Window x:Class="ScholasticaReader.Views.FlashcardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flashcards" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F9F9F9">
        <Border Background="White" CornerRadius="10" Padding="20" Margin="20" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Flashcard Questions" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock x:Name="QuestionText" Text="Question" FontSize="18" TextWrapping="Wrap" Margin="0,10,0,10" MinHeight="40"/>
                <Button Content="Show Answer" Click="ShowAnswer_Click" Margin="0,10,0,10" Padding="10,5"/>
                <TextBlock x:Name="AnswerText" Text="" FontSize="16" Visibility="Collapsed" Foreground="Green" Margin="0,10,0,10" TextWrapping="Wrap" MinHeight="40"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Easy" Click="Easy_Click" Margin="5" Padding="10,5" Width="80"/>
                    <Button Content="Hard" Click="Hard_Click" Margin="5" Padding="10,5" Width="80"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
